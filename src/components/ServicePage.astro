---
// Šablona landing page služby — jedna stránka = jeden konverzní cíl pro Google Ads.
import Layout from '../layouts/Layout.astro';
import SectionLabel from './SectionLabel.astro';
import Button from './Button.astro';
import NumberedCard from './NumberedCard.astro';
import ProjectCard from './ProjectCard.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import CtaSection from './CtaSection.astro';
import BackButton from './BackButton.astro';
import { getService, services, type Service } from '../data/services';
import { projectsByCategory } from '../data/projects';

interface Props {
  slug: string;
}

const service = getService(Astro.props.slug);
const children: Service[] = (service.children ?? []).map((s) => getService(s));
const related = projectsByCategory(service.category).slice(0, 3);
const parent = service.parent ? getService(service.parent) : null;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Úvod', item: new URL('/', Astro.site).href },
    ...(parent
      ? [{ '@type': 'ListItem', position: 2, name: parent.title, item: new URL(parent.path, Astro.site).href }]
      : []),
    {
      '@type': 'ListItem',
      position: parent ? 3 : 2,
      name: service.title,
      item: new URL(service.path, Astro.site).href,
    },
  ],
};
---

<Layout title={service.title} description={service.lead} headerVariant="overlay">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <!-- Fullscreen hero s fotkou a obrysovým titulkem -->
  <section class="relative flex min-h-[85svh] flex-col justify-end">
    <PhotoPlaceholder fill name={`service-${service.slug}`} eager label={service.title} />
    <div class="absolute inset-0 bg-gradient-to-t from-grafit/75 via-transparent to-grafit/70" aria-hidden="true"></div>
    {parent && <BackButton href={parent.path} />}

    <div class="relative z-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="px-5 pb-6 lg:px-8 lg:pb-10">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-papir">{service.label}</p>
        <h1 class="mt-3 max-w-4xl text-display font-bold leading-none text-outline-papir">{service.title}</h1>
      </div>
      <a
        href="/poptavka"
        class="group flex items-center gap-4 bg-zluta px-8 py-7 text-lg font-bold text-grafit transition-colors hover:bg-grafit hover:text-papir lg:px-12 lg:py-9"
      >
        Nezávazná poptávka
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1.5">→</span>
      </a>
    </div>
  </section>

  <!-- Lead -->
  <section class="mx-auto max-w-7xl px-5 pt-16 lg:px-8 lg:pt-20">
    <p class="max-w-3xl text-h3 font-medium leading-snug">{service.lead}</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/poptavka" arrow>Nezávazná poptávka</Button>
      <Button href="/realizace" variant="outline">Realizace</Button>
    </div>
  </section>

  <!-- Obsah + bullety -->
  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-2 lg:px-8">
    <div class="space-y-5">
      {service.description.map((p) => <p class="text-body">{p}</p>)}
    </div>
    <ul class="space-y-4 self-start border-l-2 border-zluta pl-7">
      {
        service.bullets.map((b) => (
          <li class="flex items-start gap-3 text-body font-medium">
            <span aria-hidden="true" class="mt-1 text-zluta-dark">→</span>
            {b}
          </li>
        ))
      }
    </ul>
  </section>

  {
    service.highlights && service.highlights.length > 0 && (
      <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
        <SectionLabel>{service.highlightsLabel ?? 'Výhody'}</SectionLabel>
        <h2 class="mt-3 max-w-3xl text-h2 font-bold">{service.highlightsTitle ?? 'Proč právě toto řešení'}</h2>
        <ul class="mt-10 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">
          {service.highlights.map((h) => (
            <li class="flex items-start gap-3 border-t border-grafit/10 py-5 text-body">
              <span aria-hidden="true" class="mt-0.5 font-bold text-zluta-dark">+</span>
              {h}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    service.process && service.process.length > 0 && (
      <section class="bg-grafit text-papir">
        <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
          <SectionLabel class="!text-zluta">Postup</SectionLabel>
          <h2 class="mt-3 max-w-3xl text-h2 font-bold">{service.processTitle ?? 'Postup realizace'}</h2>
          <ol class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
            {service.process.map((step, i) => (
              <li class="border-t border-papir/20 pt-6">
                <span class="text-3xl font-light tabular-nums text-zluta">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-4 text-xl font-bold">{step.title}</h3>
                <div class="mt-3 space-y-3">
                  {step.text.map((t) => (
                    <p class="text-sm leading-relaxed text-papir/70">{t}</p>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    children.length > 0 && (
      <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
        <SectionLabel>Vyberte si</SectionLabel>
        <h2 class="mt-3 text-h2 font-bold">Co přesně potřebujete?</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {children.map((child, i) => (
            <NumberedCard
              number={String(i + 1).padStart(2, '0')}
              title={child.title}
              text={child.lead}
              href={child.path}
              variant={i === 0 ? 'filled' : 'outline'}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="bg-smrk">
        <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <SectionLabel>Realizace</SectionLabel>
              <h2 class="mt-3 text-h2 font-bold">Co jsme postavili</h2>
            </div>
            <Button href="/realizace" variant="outline" arrow>Všechny realizace</Button>
          </div>
          <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {related.map((p, i) => (
              <ProjectCard project={p} number={String(i + 1).padStart(2, '0')} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <SectionLabel>Časté dotazy</SectionLabel>
    <h2 class="mt-3 text-h2 font-bold">Na co se ptáte</h2>
    <div class="mt-10 max-w-3xl divide-y divide-grafit/10 border-y border-grafit/10">
      {
        service.faq.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
              {f.q}
              <span aria-hidden="true" class="text-zluta-dark transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 max-w-2xl text-body text-grafika">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaSection title={`Poptat: ${service.title.toLowerCase()}`} />
</Layout>
