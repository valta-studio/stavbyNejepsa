---
// Fotka s cihlovým štítkem vlevo dole — vzor „01 Villa za Prahou“ z design boardu.
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  number?: string;
  ratio?: string;
  sizes?: string;
}

const { project, number, ratio = 'aspect-[4/3]', sizes } = Astro.props;
---

<a href={`/realizace/${project.slug}`} class="group block" data-categories={project.categories.join(' ')}>
  <div class="relative overflow-hidden">
    <PhotoPlaceholder src={project.image} name={`project-${project.slug}`} label={`${project.title} — ${project.location}`} ratio={ratio} sizes={sizes} />
    <span class="absolute bottom-0 left-6 inline-flex items-center gap-3 bg-zluta px-5 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-grafit transition-colors duration-200 group-hover:bg-grafit group-hover:text-papir">
      {number && <span class="font-light tabular-nums">{number}</span>}
      {project.title}
    </span>
  </div>
  <p class="mt-3 text-xs font-medium uppercase tracking-[0.15em] text-grafika">
    {project.location} · {project.year}
  </p>
</a>
