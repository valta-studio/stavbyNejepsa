---
// Renderer bloků ve struktuře Sanity Portable Text (viz projectBodies.ts).
// Po napojení CMS se jen vymění zdroj bloků — mapování typů zůstává.
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import type { RichTextBlock } from '../data/projectBodies';

interface Props {
  blocks: RichTextBlock[];
}
const { blocks } = Astro.props;

// Všechny obrázky se renderují přes celou šířku obsahu.
// Pole `layout` v datech zůstává kvůli kompatibilitě se Sanity schématem, ale ignoruje se.
---

<div class="rich-text">
  {
    blocks.map((b) => {
      if (b._type === 'imageWithMeta') {
        return (
          <figure class="clear-both my-10 max-w-[62ch] text-body">
            <PhotoPlaceholder name={b.name} label={b.alt} ratio="aspect-[3/2]" sizes="(min-width: 768px) 701px, 100vw" />
            {b.caption && (
              <figcaption class="mt-3 border-l-2 border-zluta pl-4 text-sm text-grafika">{b.caption}</figcaption>
            )}
          </figure>
        );
      }
      if (b._type === 'bulletList') {
        return (
          <ul class="my-6 max-w-[62ch] space-y-3">
            {b.items.map((item) => (
              <li class="flex items-start gap-3 text-body font-medium">
                <span aria-hidden="true" class="text-zluta-dark">→</span>
                {item}
              </li>
            ))}
          </ul>
        );
      }
      if (b.style === 'h2') {
        return <h2 class="clear-both max-w-[62ch] pt-10 text-h3 font-bold first:pt-0">{b.text}</h2>;
      }
      if (b.style === 'h3') {
        return <h3 class="max-w-[62ch] pt-6 text-xl font-bold">{b.text}</h3>;
      }
      if (b.style === 'blockquote') {
        return (
          <blockquote class="clear-both my-10 max-w-4xl border-l-4 border-zluta pl-6 text-h3 font-medium leading-snug text-grafit">
            {b.text}
          </blockquote>
        );
      }
      return <p class="mt-5 max-w-[62ch] text-body text-grafika">{b.text}</p>;
    })
  }
  <div class="clear-both"></div>
</div>
