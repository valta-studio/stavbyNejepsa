---
// Renderer bloků ve struktuře Sanity Portable Text (viz projectBodies.ts).
// Po napojení CMS se jen vymění zdroj bloků — mapování typů zůstává.
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import type { RichTextBlock } from '../data/projectBodies';

interface Props {
  blocks: RichTextBlock[];
}
const { blocks } = Astro.props;

const imageLayouts = {
  full: 'clear-both my-10',
  left: 'my-6 md:float-left md:mr-10 md:mb-6 md:w-[45%]',
  right: 'my-6 md:float-right md:mb-6 md:ml-10 md:w-[45%]',
};
---

<div class="rich-text">
  {
    blocks.map((b) => {
      if (b._type === 'imageWithMeta') {
        return (
          <figure class={imageLayouts[b.layout]}>
            <PhotoPlaceholder name={b.name} label={b.alt} ratio="aspect-[4/3]" />
            {b.caption && (
              <figcaption class="mt-3 border-l-2 border-cihla pl-4 text-sm text-grafika">{b.caption}</figcaption>
            )}
          </figure>
        );
      }
      if (b._type === 'bulletList') {
        return (
          <ul class="my-6 space-y-3">
            {b.items.map((item) => (
              <li class="flex items-start gap-3 text-body font-medium">
                <span aria-hidden="true" class="mt-1 text-cihla-dark">→</span>
                {item}
              </li>
            ))}
          </ul>
        );
      }
      if (b.style === 'h2') {
        return <h2 class="clear-both pt-10 text-h3 font-bold first:pt-0">{b.text}</h2>;
      }
      if (b.style === 'h3') {
        return <h3 class="pt-6 text-xl font-bold">{b.text}</h3>;
      }
      if (b.style === 'blockquote') {
        return (
          <blockquote class="clear-both my-10 border-l-4 border-cihla pl-6 text-h3 font-medium leading-snug text-grafit">
            {b.text}
          </blockquote>
        );
      }
      return <p class="mt-5 text-body text-grafika">{b.text}</p>;
    })
  }
  <div class="clear-both"></div>
</div>
