---
// Fixní logo vlevo + tlačítko „Menu“ vpravo, navigace jako overlay panel zprava.
// Varianta 'overlay' = bílé logo přes fotku, 'light' = grafitové logo na betonu.
import Button from './Button.astro';
import LogoMark from './LogoMark.astro';
import { site } from '../data/site';
import { services } from '../data/services';

interface Props {
  variant?: 'overlay' | 'light';
}
const { variant = 'light' } = Astro.props;

const groups = services
  .filter((s) => !s.parent)
  .map((s) => ({
    title: s.title,
    href: s.path,
    children: (s.children ?? []).map((slug) => {
      const child = services.find((x) => x.slug === slug)!;
      return { title: child.menuTitle, href: child.path };
    }),
  }));

const logoColor = variant === 'overlay' ? 'text-papir' : 'text-grafit';
// Žlutý akcent loga jen přes fotku — na světlém pozadí by byl nečitelný
const logoAccent = variant === 'overlay' ? 'text-zluta' : 'text-grafit';
// Značka je vždy v hlavní žluté; na světlém pozadí s tenkou grafitovou konturou kvůli čitelnosti
const logoMarkColor = variant === 'overlay' ? 'text-zluta' : 'text-zluta logo-mark-outline';
---

<div class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex items-center justify-between">
    <a href="/" class={`pointer-events-auto mx-5 flex items-center gap-3 lg:mx-8 ${logoColor}`} aria-label={site.name}>
      <LogoMark class={`h-10 w-auto shrink-0 ${logoMarkColor}`} />
      <span>
        <span class="block text-xl font-bold uppercase leading-none tracking-tight">Stavby</span>
        <span class={`block text-xl font-bold uppercase leading-none tracking-tight ${logoAccent}`}>Nejepsa</span>
      </span>
    </a>
    <button
      id="menu-open"
      type="button"
      class="pointer-events-auto flex items-center gap-3 bg-papir px-6 py-5 text-sm font-semibold uppercase tracking-[0.12em] text-grafit transition-colors hover:bg-zluta lg:px-8"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      Menu
      <span aria-hidden="true" class="flex flex-col gap-1">
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
      </span>
    </button>
  </div>
</div>

<!-- Overlay navigace -->
<div id="site-menu" class="invisible fixed inset-0 z-[60]" aria-hidden="true">
  <div id="menu-backdrop" class="absolute inset-0 bg-grafit/60 opacity-0 transition-opacity duration-300"></div>
  <nav
    id="menu-panel"
    class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col overflow-y-auto bg-papir px-8 pb-10 pt-6 transition-transform duration-300 lg:px-12"
    aria-label="Hlavní navigace"
  >
    <div class="flex justify-end">
      <button id="menu-close" type="button" class="p-3 text-grafit transition-colors hover:text-zluta-dark" aria-label="Zavřít menu">
        <span aria-hidden="true" class="text-3xl leading-none">×</span>
      </button>
    </div>

    <div class="mt-6 flex flex-col gap-7 text-right">
      {
        groups.map((g) => (
          <div>
            <a href={g.href} class="text-2xl font-bold text-grafit transition-colors hover:text-zluta-dark">
              {g.title}
            </a>
            {g.children.length > 0 && (
              <div class="mt-2 flex flex-col gap-1.5">
                {g.children.map((c) => (
                  <a href={c.href} class="text-base font-medium text-grafika transition-colors hover:text-zluta-dark">
                    {c.title}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }

      <div>
        <a href="/realizace" class="text-2xl font-bold text-grafit transition-colors hover:text-zluta-dark">Realizace</a>
        <div class="mt-2 flex flex-col gap-1.5">
          <a href="/technologie" class="text-base font-medium text-grafika transition-colors hover:text-zluta-dark">Technologie</a>
          <a href="/doplnkove-sluzby" class="text-base font-medium text-grafika transition-colors hover:text-zluta-dark">Doplňkové služby</a>
        </div>
      </div>
      <a href="/o-nas" class="text-2xl font-bold text-grafit transition-colors hover:text-zluta-dark">O nás</a>
      <a href="/kontakt" class="text-2xl font-bold text-grafit transition-colors hover:text-zluta-dark">Kontakt</a>
    </div>

    <div class="mt-auto flex flex-col items-end gap-5 pt-12">
      <Button href="/poptavka" arrow>Nezávazná poptávka</Button>
      <div class="flex gap-5 text-sm font-semibold uppercase tracking-[0.12em]">
        <a href={site.facebookUrl} rel="noopener" target="_blank" class="text-grafika hover:text-zluta-dark">Facebook</a>
        <a href={site.instagramUrl} rel="noopener" target="_blank" class="text-grafika hover:text-zluta-dark">Instagram</a>
        <a href={site.googleProfileUrl} rel="noopener" target="_blank" class="text-grafika hover:text-zluta-dark">Google</a>
      </div>
    </div>
  </nav>
</div>

<script>
  const root = document.getElementById('site-menu');
  const panel = document.getElementById('menu-panel');
  const backdrop = document.getElementById('menu-backdrop');
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');

  function isOpen() {
    return root?.getAttribute('aria-hidden') === 'false';
  }

  function setOpen(open: boolean) {
    if (!root || !panel || !backdrop) return;
    root.classList.toggle('invisible', !open);
    root.setAttribute('aria-hidden', String(!open));
    panel.classList.toggle('translate-x-full', !open);
    backdrop.classList.toggle('opacity-0', !open);
    openBtn?.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    // Fokus z klávesnice: do panelu při otevření, zpět na spouštěč při zavření
    if (open) closeBtn?.focus();
    else openBtn?.focus();
  }

  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  backdrop?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) setOpen(false);
  });

  // Tab zůstává uvnitř otevřeného panelu
  panel?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen()) return;
    const focusables = panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
