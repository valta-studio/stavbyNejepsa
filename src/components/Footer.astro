---
import { site, contacts, tel } from '../data/site';
import { mainServices } from '../data/services';
import LogoMark from './LogoMark.astro';

const year = new Date().getFullYear();
---

<footer class="bg-grafit text-papir">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div>
      <p class="flex items-center gap-3 text-lg font-bold uppercase tracking-tight">
        <LogoMark class="h-8 w-auto shrink-0 text-zluta" />
        <span>Stavby <span class="text-zluta">Nejepsa</span></span>
      </p>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-papir/70">
        {site.claim}. Rodinná stavební firma — stavíme, jako bychom stavěli pro sebe.
      </p>
      <a
        href={site.googleProfileUrl}
        rel="noopener"
        target="_blank"
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-zluta hover:text-papir"
      >
        Recenze na Google profilu <span aria-hidden="true">→</span>
      </a>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-papir/50">Služby</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          mainServices.map((s) => (
            <li>
              <a href={s.path} class="text-papir/80 hover:text-zluta">
                {s.title}
              </a>
            </li>
          ))
        }
        <li><a href="/realizace" class="text-papir/80 hover:text-zluta">Realizace</a></li>
        <li><a href="/technologie" class="text-papir/80 hover:text-zluta">Technologie</a></li>
        <li><a href="/doplnkove-sluzby" class="text-papir/80 hover:text-zluta">Doplňkové služby</a></li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-papir/50">Sídlo</p>
      <address class="mt-4 text-sm not-italic leading-relaxed text-papir/80">
        {site.name}
        <br />
        {site.address.street}
        <br />
        {site.address.zip} {site.address.city}
      </address>
      <p class="mt-3 text-xs text-papir/50">IČO {site.ico} · DIČ {site.dic}</p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-papir/50">Kontakt</p>
      <div class="mt-4 space-y-4 text-sm">
        {
          contacts.map((c) => (
            <p>
              <span class="block text-papir/50">{c.name}</span>
              <a href={tel(c.phone)} class="block text-papir hover:text-zluta" data-track="phone">
                {c.phone}
              </a>
              <a href={`mailto:${c.email}`} class="block text-papir/80 hover:text-zluta" data-track="email">
                {c.email}
              </a>
            </p>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-papir/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-6 text-xs text-papir/50 sm:flex-row sm:items-center sm:justify-between lg:px-8">
      <p>© {year} {site.name} · IČO {site.ico}</p>
      <div class="flex gap-5">
        <a href={site.facebookUrl} rel="noopener" target="_blank" class="hover:text-papir">Facebook</a>
        <a href={site.instagramUrl} rel="noopener" target="_blank" class="hover:text-papir">Instagram</a>
        <a href="/kontakt" class="hover:text-papir">Kontakt</a>
        <a href="/poptavka" class="hover:text-papir">Nezávazná poptávka</a>
      </div>
    </div>
  </div>
</footer>
