---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'dark';
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'solid', arrow = false, class: className = '' } = Astro.props;

// Externí odkazy (Google recenze apod.) otevírat v nové záložce, ať návštěvník neopustí web.
const external = /^https?:\/\//.test(href);

const base =
  'inline-flex items-center justify-center gap-3 px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.12em] transition-colors duration-200';

const variants = {
  solid: 'bg-zluta text-grafit hover:bg-grafit hover:text-papir',
  outline: 'border border-grafit text-grafit hover:border-zluta hover:bg-zluta',
  dark: 'bg-grafit text-papir hover:bg-zluta hover:text-grafit',
};
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class={`${base} ${variants[variant]} ${className}`}>
  <slot />
  {arrow && <span aria-hidden="true" class="text-base leading-none">→</span>}
</a>
