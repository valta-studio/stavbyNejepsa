---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { projects } from '../../data/projects';
import { mainServices } from '../../data/services';

const filters = [
  { key: 'vse', label: 'Vše' },
  ...mainServices.map((s) => ({ key: s.category, label: s.title })),
];
---

<Layout
  title="Realizace"
  description="Vybrané realizace — rodinné domy na klíč, rekonstrukce, střechy a fasády. Skutečné zakázky, skutečné fotografie."
>
  <section class="mx-auto max-w-7xl px-5 pb-10 pt-6 lg:px-8 lg:pt-10">
    <SectionLabel>Naše práce</SectionLabel>
    <h1 class="mt-4 text-display font-bold">Realizace</h1>
    <p class="mt-6 max-w-2xl text-body text-grafika">
      Každou oblast prezentujeme vlastními fotografiemi ze skutečných staveb. Vyberte kategorii,
      nebo procházejte všechny zakázky.
    </p>

    <div class="mt-10 flex flex-wrap gap-2" id="project-filters">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            class={`border px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.12em] transition-colors ${
              i === 0
                ? 'border-zluta bg-zluta text-grafit'
                : 'border-grafit/20 bg-transparent text-grafit hover:border-grafit'
            }`}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 lg:px-8">
    <!-- Velké foto-karty přes dva sloupce — fotky hrají hlavní roli -->
    <div class="grid gap-x-10 gap-y-14 md:grid-cols-2" id="project-grid">
      {projects.map((p, i) => <ProjectCard project={p} number={String(i + 1).padStart(2, '0')} ratio="aspect-[16/10]" />)}
    </div>
    <p id="no-results" class="hidden py-16 text-center text-body text-grafika">
      V této kategorii zatím nemáme zveřejněnou žádnou realizaci.
    </p>
  </section>

  <CtaSection />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#project-filters button');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid > a');
  const noResults = document.getElementById('no-results');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'vse';
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-zluta', active);
        b.classList.toggle('border-zluta', active);
        b.classList.toggle('border-grafit/20', !active);
      });
      let visible = 0;
      cards.forEach((card) => {
        const categories = (card.dataset.categories ?? '').split(' ');
        const show = filter === 'vse' || categories.includes(filter);
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      noResults?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
