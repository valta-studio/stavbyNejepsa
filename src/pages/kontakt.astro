---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { site, branches } from '../data/site';

// LocalBusiness structured data pro každou pobočku zvlášť (viz projektový kontext)
const jsonLd = branches.map((b) => ({
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: `${site.name} — ${b.name}`,
  telephone: b.phone,
  email: b.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: b.street,
    addressLocality: b.city,
    postalCode: b.zip,
    addressCountry: 'CZ',
  },
  url: new URL('/kontakt', Astro.site).href,
}));
---

<Layout
  title="Kontakt"
  description="Kontakty na obě pobočky stavební firmy Stavby Nejepša — adresy, telefony, e-maily a otvírací doba."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="mx-auto max-w-7xl px-5 pb-12 pt-6 lg:px-8 lg:pt-10">
    <SectionLabel>Spojte se s námi</SectionLabel>
    <h1 class="mt-4 text-display font-bold">Kontakt</h1>
    <p class="mt-6 max-w-2xl text-body text-grafika">
      Najdete nás na dvou pobočkách. Nejrychlejší cesta k nabídce je
      <a href="/poptavka" class="font-semibold text-cihla-dark underline underline-offset-4 hover:text-grafit">nezávazná poptávka</a>
      — ozveme se do dvou pracovních dnů.
    </p>
  </section>

  <section class="mx-auto grid max-w-7xl gap-8 px-5 pb-24 md:grid-cols-2 lg:px-8">
    {
      branches.map((b, i) => (
        <div class="bg-papir">
          <PhotoPlaceholder name={i === 0 ? 'branch-praha' : 'branch-2'} label={`${b.name} — provozovna`} ratio="aspect-[16/9]" />
          <div class="p-8">
            <span class="text-3xl font-light tabular-nums text-cihla-dark">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="mt-3 text-h3 font-bold">{b.name}</h2>
            <address class="mt-4 text-body not-italic text-grafika">
              {b.street}
              <br />
              {b.zip} {b.city}
            </address>
            <p class="mt-5 space-y-1">
              <a href={`tel:${b.phone.replace(/\s/g, '')}`} class="block text-xl font-semibold hover:text-cihla-dark" data-track="phone">
                {b.phone}
              </a>
              <a href={`mailto:${b.email}`} class="block text-body text-grafika hover:text-cihla-dark" data-track="email">
                {b.email}
              </a>
            </p>
            <p class="mt-4 text-sm text-grafika">{b.hours}</p>
            <div class="mt-6">
              <Button
                href={`https://www.google.com/maps/search/${encodeURIComponent(`${b.street}, ${b.city}`)}`}
                variant="outline"
                arrow
              >
                Navigovat
              </Button>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <section class="bg-grafit text-papir">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-5 py-16 lg:flex-row lg:items-center lg:px-8">
      <div>
        <h2 class="text-h3 font-bold">Fakturační údaje</h2>
        <p class="mt-3 text-body text-papir/75">
          {site.name} · IČO {site.ico}
          <!-- TODO: doplnit sídlo, DIČ a údaje pro právní texty -->
        </p>
      </div>
      <Button href="/poptavka" arrow>Nezávazná poptávka</Button>
    </div>
  </section>
</Layout>
