---
import Layout from '../layouts/Layout.astro';
import BackButton from '../components/BackButton.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import { site, contacts, tel } from '../data/site';

const { address } = site;
const addressLine = `${address.street}, ${address.zip} ${address.city}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  telephone: site.phone,
  email: site.email,
  vatID: site.dic,
  taxID: site.ico,
  address: {
    '@type': 'PostalAddress',
    streetAddress: address.street,
    addressLocality: address.city,
    postalCode: address.zip,
    addressCountry: 'CZ',
  },
  employee: contacts.map((c) => ({
    '@type': 'Person',
    name: c.name,
    ...(c.role && { jobTitle: c.role }),
    telephone: c.phone,
    email: c.email,
  })),
  sameAs: [site.facebookUrl, site.instagramUrl],
  url: new URL('/kontakt', Astro.site).href,
};
---

<Layout
  title="Kontakt"
  description={`Kontakt na stavební firmu ${site.name} — ${addressLine}. Telefon ${site.phone}, e-mail ${site.email}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="mx-auto max-w-7xl px-5 pb-12 pt-6 lg:px-8 lg:pt-10">
    <BackButton href="/" variant="inline" />
    <SectionLabel>Spojte se s námi</SectionLabel>
    <h1 class="mt-4 text-display font-bold">Kontakt</h1>
    <p class="mt-6 max-w-2xl text-body text-grafika">
      Zavolejte nebo napište přímo nám. Nejrychlejší cesta k nabídce je
      <a href="/poptavka" class="font-semibold text-zluta-dark underline underline-offset-4 hover:text-grafit">nezávazná poptávka</a>
      — ozveme se do dvou pracovních dnů.
    </p>
  </section>

  <section class="mx-auto grid max-w-7xl gap-8 px-5 pb-16 md:grid-cols-2 lg:px-8">
    {
      contacts.map((c, i) => (
        <div class="bg-papir p-8">
          <span class="text-3xl font-light tabular-nums text-zluta-dark">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="mt-3 text-h3 font-bold">{c.name}</h2>
          {c.role && <p class="mt-1 text-sm font-semibold uppercase tracking-[0.15em] text-grafika">{c.role}</p>}
          <p class="mt-5 space-y-1">
            <a href={tel(c.phone)} class="block text-xl font-semibold hover:text-zluta-dark" data-track="phone">
              {c.phone}
            </a>
            <a href={`mailto:${c.email}`} class="wrap-anywhere block text-body text-grafika hover:text-zluta-dark" data-track="email">
              {c.email}
            </a>
          </p>
        </div>
      ))
    }
  </section>

  <section class="mx-auto grid max-w-7xl gap-8 px-5 pb-24 md:grid-cols-2 lg:px-8">
    <div>
      <SectionLabel>Sídlo firmy</SectionLabel>
      <address class="mt-4 text-h3 font-bold not-italic">
        {address.street}
        <br />
        {address.zip} {address.city}
      </address>
      <div class="mt-6">
        <Button
          href={`https://www.google.com/maps/search/${encodeURIComponent(addressLine)}`}
          variant="outline"
          arrow
        >
          Navigovat
        </Button>
      </div>
    </div>
    <div>
      <SectionLabel>Sledujte nás</SectionLabel>
      <ul class="mt-4 space-y-2 text-body">
        <li>
          <a href={site.facebookUrl} rel="noopener" target="_blank" class="font-semibold hover:text-zluta-dark">
            Facebook — @StavbyNejepsa
          </a>
        </li>
        <li>
          <a href={site.instagramUrl} rel="noopener" target="_blank" class="font-semibold hover:text-zluta-dark">
            Instagram — @stavby_nejepsa_sro
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="bg-grafit text-papir">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-5 py-16 lg:flex-row lg:items-center lg:px-8">
      <div>
        <h2 class="text-h3 font-bold">Fakturační údaje</h2>
        <p class="mt-3 text-body text-papir/75">
          {site.name} · {addressLine}
          <br />
          IČO {site.ico} · DIČ {site.dic}
        </p>
      </div>
      <Button href="/poptavka" arrow>Nezávazná poptávka</Button>
    </div>
  </section>
</Layout>
