---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import CtaSection from '../components/CtaSection.astro';

interface DoplnkovaSluzba {
  name: string;
  paragraphs: string[];
  steps?: { title: string; items: string[] }[];
}

const doplnkoveSluzby: DoplnkovaSluzba[] = [
  {
    name: 'Projektování',
    paragraphs: [
      'Kompletní stavební a montážní práce zajišťujeme „na klíč“, popřípadě formou dokončení, kterou si určí sám investor. Prioritou je pro nás spokojenost zákazníka ve všech oblastech stavby.',
      'Cenovou úroveň a kvalitu práce zajišťujeme pomocí úzké spolupráce s dodavateli materiálů. Do té spadají školení a přednášky, a to například při použití moderních stavebních technologií. I díky tomu vám můžeme garantovat 100% spokojenost s veškerou naší prací.',
      'Na trhu působíme už více než 20 let. Za tu dobu jsme nasbírali zkušenosti v oblastech rekonstrukcí rodinných domů a bytových jednotek, výstavby rodinných domů, SDK konstrukcí, výroby a montáže dřevostaveb, projektové činnosti a financování.',
    ],
  },
  {
    name: 'Vyřízení Nová zelená úsporám',
    paragraphs: [
      'Zprostředkujeme vám dotaci z programu Nová zelená úsporám, a to včetně odborného posudku, projektové dokumentace a energetického posudku.',
      'Poskytneme vám energeticko-ekonomické studie, projektové dokumentace, energetické audity a jednání se Státním fondem životního prostředí. Dále i projekční a poradenskou činnost, analýzy, kontroly a vyhotovení všech potřebných dokumentů.',
    ],
  },
  {
    name: 'Stavební povolení',
    paragraphs: [
      'Při cestě za vlastním bydlením vám chceme být co největší oporou. Proto vám ulehčíme i běhání po úřadech při zajišťování stavebního povolení či ohlášení stavby.',
      'Vyřízení povolení stavby svěřte nám, vy svůj čas věnujte důležitějším věcem. Služba Vyřízení povolení stavby v sobě kombinuje tyto kroky:',
    ],
    steps: [
      {
        title: 'Příprava',
        items: [
          'prověříme, zda je na daném pozemku možné stavět',
          'projednáme stavební záměr s úřady',
          'prověříme regulativy a možnosti výstavby pro daný pozemek',
          'zajistíme podklady pro projektanta ke zpracování koordinační situace (nezahrnuje geodetické podklady)',
          'zjistíme úřady požadovaný rozsah dokumentace a případných doplňkových projektů dle dostupných informací',
          'zjistíme rozsah potřebných vyjádření, dokladů, souhlasů a stanovisek požadovaných stavebním (nebo jiným) úřadem k příslušnému druhu řízení',
        ],
      },
      {
        title: 'Vyřízení povolení stavby',
        items: [
          'podáme žádosti nezbytné k povolení stavby',
          'obstaráme doklady, vyjádření a závazná stanoviska dle příkazní smlouvy',
          'zajistíme výpis z katastru (doklad o vlastnictví), snímek pozemkové mapy, seznam vlastníků sousedních parcel a staveb na nich',
          'sjednáme napojení domu a pozemku na inženýrské sítě',
          'předáme vám všechny dokumenty včetně cedule „Stavba povolena“',
        ],
      },
    ],
  },
  {
    name: 'Financování',
    paragraphs: [
      'Nabízíme vám komplexní řešení financování od A do Z.',
      'Díky spolupráci s experty na trhu hypoték vám zajistíme nejvýhodnější financování přesně na míru. Kromě samotné výstavby rodinného domu do něj zahrneme i pozemek a vybavení. Hypoteční úvěr si můžete sjednat u různých bank.',
    ],
  },
];

---

<Layout
  title="Doplňkové služby"
  description="Projektování, vyřízení dotace Nová zelená úsporám, stavební povolení a financování na míru. Postaráme se o vše kolem stavby, abyste nemuseli běhat po úřadech."
>
  <section class="mx-auto max-w-7xl px-5 pb-12 pt-6 lg:px-8 lg:pt-10">
    <SectionLabel>Doplňkové služby</SectionLabel>
    <h1 class="mt-4 text-display font-bold">Doplňkové služby</h1>
    <p class="mt-6 max-w-2xl text-body text-grafika">
      Jsme hrdí na to, že můžeme nabídnout další služby, které nám umožňují dosáhnout pro naše
      klienty těch nejlepších výsledků.
    </p>
  </section>

  <section class="mx-auto max-w-7xl space-y-6 px-5 pb-24 lg:px-8">
    {
      doplnkoveSluzby.map((s, i) => (
        <div class="grid gap-8 bg-papir p-8 lg:grid-cols-[1fr_3fr] lg:p-10">
          <div>
            <span class="text-3xl font-light tabular-nums text-zluta-dark">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="mt-3 text-h3 font-bold">{s.name}</h2>
          </div>
          <div class="max-w-3xl space-y-4">
            {s.paragraphs.map((p) => (
              <p class="text-body text-grafika">{p}</p>
            ))}
            {s.steps && (
              <div class="grid gap-6 pt-4 md:grid-cols-2">
                {s.steps.map((step, j) => (
                  <div class="border-t border-grafit/10 pt-5">
                    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-zluta-dark">{j + 1}. krok</p>
                    <h3 class="mt-2 text-lg font-bold">{step.title}</h3>
                    <ul class="mt-4 space-y-2">
                      {step.items.map((item) => (
                        <li class="flex gap-3 text-sm text-grafika">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-zluta" aria-hidden="true" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </section>

  <CtaSection />
</Layout>
