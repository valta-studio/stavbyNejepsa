---
// Samostatná konverzní URL pro Google Ads (primární konverze).
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---

<Layout title="Děkujeme za poptávku" description="Vaši poptávku jsme přijali. Ozveme se do dvou pracovních dnů.">
  <section class="mx-auto flex max-w-7xl flex-col items-start px-5 py-28 lg:px-8">
    <SectionLabel>Poptávka odeslána</SectionLabel>
    <h1 class="mt-4 text-display font-bold">Děkujeme</h1>
    <p class="mt-6 max-w-2xl text-h3 font-medium leading-snug">
      Vaši poptávku jsme přijali — ozveme se do dvou pracovních dnů.
    </p>
    <p class="mt-4 max-w-2xl text-body text-grafika">
      Pokud spěcháte, zavolejte nám přímo na
      <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="font-semibold text-zluta-dark underline underline-offset-4 hover:text-grafit" data-track="phone">
        {site.phone}
      </a>.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/realizace" arrow>Prohlédnout realizace</Button>
      <Button href="/" variant="outline">Zpět na úvod</Button>
    </div>
  </section>
</Layout>
