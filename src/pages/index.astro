---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CtaSection from '../components/CtaSection.astro';
import DotNav from '../components/DotNav.astro';
import { site } from '../data/site';
import { mainServices } from '../data/services';
import { featuredProjects, projects } from '../data/projects';
import { technologies } from '../data/technologies';

const whyUs = [
  {
    title: 'Rodinná firma',
    text: 'Stavbu vede majitel, ne anonymní dispečink. Jste v kontaktu s člověkem, který za dílo ručí jménem.',
  },
  {
    title: 'Vlastní lidé',
    text: 'Tesaři, zedníci i pokrývači jsou naši kmenoví pracovníci. Nepřeprodáváme zakázky dál.',
  },
  {
    title: 'Prověřené materiály',
    text: 'Pracujeme se systémy renomovaných výrobců a jako proškolení aplikátoři přenášíme jejich záruky na vás.',
  },
  {
    title: 'Rozpočet předem',
    text: 'Položkový rozpočet a harmonogram dostanete před podpisem smlouvy. Vícepráce jen po odsouhlasení.',
  },
];

const slides = featuredProjects.slice(0, 3);
const latest = [...projects].sort((a, b) => b.year - a.year).slice(0, 4);

const dotItems = [
  { id: 'uvod', label: 'Úvod' },
  ...slides.map((p, i) => ({ id: `projekt-${i + 1}`, label: p.title })),
  { id: 'obsah', label: 'Více o firmě' },
];
---

<Layout
  title="Stavby, rekonstrukce a střechy na klíč"
  description="Rodinná stavební firma. Rodinné domy na klíč, rekonstrukce, ploché i šikmé střechy a fasády. Kompletní realizace staveb s vlastními lidmi a prověřenými materiály."
  headerVariant="overlay"
>
  <DotNav items={dotItems} />

  <!-- Slide 1: fullscreen hero s kartami hlavních služeb -->
  <section id="uvod" class="slide relative flex min-h-svh flex-col">
    <PhotoPlaceholder fill name="home-hero" eager label="Moderní rodinný dům na klíč s dřevěnou fasádou" />
    <div class="absolute inset-0 bg-gradient-to-t from-grafit/70 via-grafit/20 to-grafit/30" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-5 pt-28 lg:px-8">
      <h1 class="max-w-5xl text-display font-bold text-papir">
        Dřevostavby i zděné domy <span class="text-outline-papir">na klíč</span>
      </h1>
      <p class="mt-6 max-w-xl text-body font-medium text-papir/90">
        Rodinná stavební firma — kompletní realizace staveb, rekonstrukce, střechy a fasády.
      </p>
    </div>

    <!-- Vstupy do hlavních služeb (workflow „rozcestník na hero“) -->
    <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-2 gap-3 px-5 pb-10 md:grid-cols-4 lg:gap-5 lg:px-8">
      {
        mainServices.map((s) => (
          <a
            href={s.path}
            class="group relative bg-papir px-5 py-5 text-base font-bold text-grafit transition-colors hover:bg-grafit hover:text-papir lg:px-7 lg:py-6 lg:text-lg"
          >
            {s.title}
            <span class="absolute inset-x-0 bottom-0 h-1 bg-cihla" aria-hidden="true" />
            <span aria-hidden="true" class="mt-1 block text-cihla transition-transform duration-200 group-hover:translate-x-1.5">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Slidy 2–4: vybrané realizace přes celou obrazovku -->
  {
    slides.map((p, i) => (
      <section id={`projekt-${i + 1}`} class="slide relative flex min-h-svh flex-col justify-end">
        <PhotoPlaceholder fill name={`project-${p.slug}`} label={`${p.title} — ${p.location}`} />
        <div class="absolute inset-0 bg-gradient-to-t from-grafit/60 via-transparent to-transparent" aria-hidden="true" />

        <div class="relative z-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <div class="px-5 pb-6 lg:px-8 lg:pb-10">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-papir/80">
              <span class="text-cihla">{String(i + 1).padStart(2, '0')}</span> · {p.location} · {p.year}
            </p>
            <h2 class="mt-3 max-w-4xl text-display font-bold leading-none text-outline-papir">{p.title}</h2>
          </div>
          <a
            href={`/realizace/${p.slug}`}
            class="group flex items-center gap-4 bg-cihla px-8 py-7 text-lg font-bold text-papir transition-colors hover:bg-grafit lg:px-12 lg:py-9"
          >
            Prohlédnout si detail stavby
            <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1.5">→</span>
          </a>
        </div>
      </section>
    ))
  }

  <!-- Obsahová část -->
  <div id="obsah">
    <!-- Proč my -->
    <section class="slide bg-grafit text-papir">
      <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
        <SectionLabel class="!text-cihla">Proč my</SectionLabel>
        <h2 class="mt-3 max-w-3xl text-h2 font-bold">Proč si vybrat naši firmu</h2>
        <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
          {
            whyUs.map((item, i) => (
              <div class="border-t border-papir/20 pt-6">
                <span class="text-3xl font-light tabular-nums text-cihla">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-4 text-xl font-bold">{item.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-papir/70">{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Technologie a dodavatelé -->
    <section class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <SectionLabel>Materiály a systémy</SectionLabel>
          <h2 class="mt-3 text-h2 font-bold">Používané technologie</h2>
        </div>
        <Button href="/technologie" variant="outline" arrow>Všechny technologie</Button>
      </div>
      <div class="mt-12 grid gap-px bg-grafit/10 sm:grid-cols-2 lg:grid-cols-3">
        {
          technologies.slice(0, 6).map((t) => (
            <div class="bg-beton p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-grafika">{t.usedFor}</p>
              <h3 class="mt-2 text-lg font-bold">{t.name}</h3>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Poslední realizace / Instagram -->
    <section class="bg-smrk">
      <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <SectionLabel>Ze stavby</SectionLabel>
            <h2 class="mt-3 text-h2 font-bold">Poslední realizace</h2>
          </div>
          <a
            href={site.instagramUrl}
            rel="noopener"
            target="_blank"
            class="inline-flex items-center gap-3 bg-grafit px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.12em] text-papir transition-colors hover:bg-cihla"
          >
            Sledujte nás na Instagramu <span aria-hidden="true">→</span>
          </a>
        </div>
        <!-- Po spuštění: komponenta InstagramEmbed (iframe, lazy, consent gate) dle projektového kontextu -->
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            latest.map((p) => (
              <a href={`/realizace/${p.slug}`} class="group block">
                <PhotoPlaceholder name={`project-${p.slug}`} label={p.title} ratio="aspect-square" />
                <p class="mt-3 text-sm font-semibold group-hover:text-cihla-dark">{p.title}</p>
                <p class="text-xs uppercase tracking-[0.15em] text-grafika">{p.location} · {p.year}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Google recenze -->
    <section class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-8 border-y border-grafit/10 py-14 lg:flex-row lg:items-center">
        <div>
          <SectionLabel>Reference</SectionLabel>
          <h2 class="mt-3 max-w-xl text-h2 font-bold">Co o nás říkají klienti</h2>
          <p class="mt-4 max-w-xl text-body text-grafika">
            Hodnocení našich zakázek najdete na našem Google profilu — nic neupravujeme, recenze píšou sami klienti.
          </p>
        </div>
        <Button href={site.googleProfileUrl} variant="dark" arrow>Přečíst recenze na Google</Button>
      </div>
    </section>

    <!-- Nezávazná poptávka (kontakty a pobočky jsou v patičce) -->
    <CtaSection />
  </div>
</Layout>
