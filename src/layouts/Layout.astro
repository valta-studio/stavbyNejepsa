---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  // 'overlay' = stránka začíná fullscreen fotkou (header přes ni), 'light' = obsahová stránka na betonu
  headerVariant?: 'overlay' | 'light';
  // OG/sociální náhled — cesta v /public nebo absolutní URL; výchozí karta 1200×630
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  headerVariant = 'light',
  ogImage = '/og-default.jpg',
  ogImageAlt = `${site.shortName} – ${site.claim}`,
} = Astro.props;
const fullTitle = `${title} | ${site.shortName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e8e6e1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- TODO: favicon set; OG karta zatím s textovým logem — po dodání vektorového loga přegenerovat -->
  </head>
  <body class="flex min-h-screen flex-col">
    <Header variant={headerVariant} />
    <!-- Safari (iOS 26) barví spodní lištu podle fixního prvku u spodního okraje — bez něj je lišta průhledná přes obsah -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-x-0 bottom-0 z-40 h-px bg-beton lg:hidden"></div>
    <main class={`flex-1 ${headerVariant === 'light' ? 'pt-24 lg:pt-28' : ''}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
