---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  // 'overlay' = stránka začíná fullscreen fotkou (header přes ni), 'light' = obsahová stránka na betonu
  headerVariant?: 'overlay' | 'light';
  // OG/sociální náhled — cesta v /public nebo absolutní URL; výchozí karta 1200×630
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  headerVariant = 'light',
  ogImage = '/og-default.jpg',
  ogImageAlt = `${site.shortName} – ${site.claim}`,
} = Astro.props;
const fullTitle = `${title} | ${site.shortName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e4e2dd" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- TODO: OG karta zatím s textovým logem — po dodání vektorového loga přegenerovat -->
    <script is:inline>
      // Zafixuje --hero-h v px, přepočítá jen při změně šířky (otočení telefonu).
      // Změny pouze výšky (schovávání lišty in-app prohlížečů, klávesnice) ignoruje,
      // jinak by fullscreen sekce při scrollu měnily výšku a obsah by skákal.
      (() => {
        let w = 0;
        const set = () => {
          if (window.innerWidth === w) return;
          w = window.innerWidth;
          document.documentElement.style.setProperty('--hero-h', window.innerHeight + 'px');
        };
        set();
        window.addEventListener('resize', set);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header variant={headerVariant} />
    <main class={`flex-1 ${headerVariant === 'light' ? 'pt-24 lg:pt-28' : ''}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
